  "rule_template": "WITH null_count AS (SELECT COUNT(*) AS total_nulls FROM {database_name}.{schema_name}.{table_name} WHERE {column_name} IS NULL AND {additional_filters}), overall_count AS (SELECT COUNT(*) AS total_rows FROM {database_name}.{schema_name}.{table_name} WHERE {additional_filters}) SELECT total_rows AS rows_total, (total_rows - total_nulls) AS rows_passed, total_nulls AS rows_failed, CASE WHEN try_divide((total_rows - total_nulls) * 100.0, total_rows) >= {tolerance(%)} THEN 'PASS' ELSE 'FAIL' END AS status FROM null_count, overall_count;",
